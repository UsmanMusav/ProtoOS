# ProtoOS Full Motion: the requested all-effects profile. It enables the full
# set of KWin visual transitions by default; users can still use Alt+Shift+F12
# or System Settings → Window Effects when a VM has insufficient graphics power.
[Compositing]
AnimationSpeed=3
Backend=OpenGL
Enabled=true
OpenGLIsUnsafe=false

[Plugins]
# Core window, dialog, popup and workspace animation effects.
dialogparentEnabled=true
desktopgridEnabled=true
fadeEnabled=true
fallapartEnabled=true
glideEnabled=true
highlightwindowEnabled=true
loginEnabled=true
logoutEnabled=true
magiclampEnabled=true
maximizeEnabled=true
overviewEnabled=true
scaleEnabled=true
sheetEnabled=true
slideEnabled=true
slidingpopupsEnabled=true
snaphelperEnabled=true
squashEnabled=true
startupfeedbackEnabled=true
translucencyEnabled=true
windowapertureEnabled=true
wobblywindowsEnabled=true

# Full visual effects requested for the default profile.
blurEnabled=true
contrastEnabled=true
cubeEnabled=true
cubeslideEnabled=true
diminactiveEnabled=true
dimscreenEnabled=true
magnifierEnabled=true
zoomEnabled=true

[org.kde.kdecoration2]
# Familiar left-side window controls, while retaining ProtoOS colors and the
# standard Plasma accessibility semantics instead of copying Apple artwork.
ButtonsOnLeft=XIA
ButtonsOnRight=

[Windows]
RollOverDesktops=false
