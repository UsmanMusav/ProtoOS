# ProtoOS Aurora Performance shell: one restrained top bar and a compact
# icon-only application strip. No third-party dock or GPU-heavy widget is used.
[Containments][1]
activityId=
formfactor=0
immutability=1
lastScreen=0
location=0
plugin=org.kde.plasma.folder
wallpaperplugin=org.kde.image

[Containments][1][Wallpaper][org.kde.image][General]
Image=file:///home/protoos/.local/share/wallpapers/ProtoOS/contents/images/2560x1440.png
PreviewImage=file:///home/protoos/.local/share/wallpapers/ProtoOS/contents/images/2560x1440.png

[Containments][2]
activityId=
formfactor=2
immutability=1
lastScreen=0
location=3
plugin=org.kde.panel
wallpaperplugin=org.kde.image

[Containments][2][Applets][3]
immutability=1
plugin=org.kde.plasma.kickoff

[Containments][2][Applets][3][Configuration][General]
# A named Home button and a familiar house icon make the primary navigation
# obvious, instead of presenting an unlabelled stock Plasma launcher.
icon=protoos-home
menuLabel=Home
favoriteApps=applications:org.protoos.welcome.desktop,applications:org.protoos.proton.desktop,applications:org.protoos.computer.desktop,applications:org.kde.dolphin.desktop,applications:org.kde.kate.desktop,applications:org.kde.gwenview.desktop,applications:org.kde.kcalc.desktop,applications:org.protoos.monitor.desktop,applications:systemsettings.desktop
appNameFormat=0
favoritesDisplay=0
applicationsDisplay=0
alphaSort=true
compactMode=false
highlightNewlyInstalledApps=false
switchCategoryOnHover=false
showActionButtonCaptions=true

[Containments][2][Applets][4]
immutability=1
plugin=org.kde.plasma.panelspacer

[Containments][2][Applets][5]
immutability=1
plugin=org.kde.plasma.digitalclock

[Containments][2][Applets][5][Configuration][Appearance]
showDate=false
showSeconds=false

[Containments][2][Applets][6]
immutability=1
plugin=org.kde.plasma.systemtray

[Containments][2][General]
# A full-width translucent menu bar anchors Home, time and system controls.
AppletOrder=3;4;5;6
floating=0
panelLengthMode=0
panelOpacity=2
thickness=30

[Containments][3]
activityId=
formfactor=2
immutability=1
lastScreen=0
location=4
plugin=org.kde.panel
wallpaperplugin=org.kde.image

[Containments][3][Applets][7]
immutability=1
plugin=org.kde.plasma.panelspacer

[Containments][3][Applets][8]
immutability=1
plugin=org.kde.plasma.icontasks

[Containments][3][Applets][8][Configuration][General]
launchers=applications:org.protoos.welcome.desktop,applications:org.protoos.proton.desktop,applications:org.kde.dolphin.desktop,applications:org.kde.kate.desktop,applications:org.kde.okular.desktop,applications:org.kde.gwenview.desktop,applications:systemsettings.desktop
showOnlyCurrentDesktop=false
showOnlyCurrentScreen=false
showOnlyMinimized=false

[Containments][3][Applets][9]
immutability=1
plugin=org.kde.plasma.panelspacer

[Containments][3][General]
# A centered, content-sized floating dock gives fast app switching a familiar
# macOS-like shape while keeping the visual identity completely ProtoOS.
AppletOrder=8
alignment=4
floating=1
panelLengthMode=1
panelOpacity=2
thickness=52
