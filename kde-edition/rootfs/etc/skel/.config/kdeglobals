[General]
ColorScheme=ProtoOS Proton Dark

[Icons]
# ProtoOS-Aurora supplies the branded app icons and explicitly inherits the
# complete Breeze and hicolor themes, preventing missing system/mime icons.
Theme=ProtoOS-Aurora

[KDE]
# Proton Flow makes each state change visible but keeps it short. Users who
# prefer reduced motion can set this to 0 in System Settings; Alt+Shift+F12
# remains an instant compositor toggle for a constrained VM.
AnimationDurationFactor=0.60
LookAndFeelPackage=org.protoos.desktop
SingleClick=false

