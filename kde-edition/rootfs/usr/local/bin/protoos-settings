#!/bin/sh
# A concise settings entry point for a Live desktop. The broader Quick Center
# is separate so Settings can still lead naturally to the complete control set.
set -u

if ! command -v kdialog >/dev/null 2>&1; then
    exec systemsettings
fi

case "${LANG:-${LC_MESSAGES:-}}" in
    ru*|RU*)
        title='Настройки ProtoOS'
        prompt='Часто используемые настройки. Для сети, звука и экрана можно также открыть «Центр управления».'
        center='Открыть Центр управления'
        network='Сеть и интернет'
        audio='Звук и микрофон'
        display='Экран и разрешение'
        appearance='Оформление и цвета'
        motion='Эффекты и анимации окон'
        all='Все системные настройки'
        ;;
    *)
        title='ProtoOS Settings'
        prompt='Common settings. Open Control Center as well for network, audio and display shortcuts.'
        center='Open Control Center'
        network='Network and internet'
        audio='Sound and microphone'
        display='Display and resolution'
        appearance='Appearance and colors'
        motion='Window effects and animations'
        all='All System Settings'
        ;;
esac

choice=$(kdialog --title "$title" --icon protoos-settings --menu "$prompt" \
    center "$center" \
    network "$network" \
    audio "$audio" \
    display "$display" \
    appearance "$appearance" \
    motion "$motion" \
    all "$all") || exit 0

case "$choice" in
    center) exec protoos-control-center ;;
    network) exec systemsettings kcm_networkmanagement ;;
    audio) exec systemsettings kcm_pulseaudio ;;
    display) exec systemsettings kcm_kscreen ;;
    appearance) exec systemsettings kcm_colors ;;
    motion) exec systemsettings kcm_kwin_effects ;;
    all) exec systemsettings ;;
esac
