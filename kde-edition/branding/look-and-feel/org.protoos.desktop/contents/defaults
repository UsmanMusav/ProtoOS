# Defaults consumed when the ProtoOS appearance package is selected.
# Keep the visual identity local to ProtoOS while retaining standard Plasma
# accessibility and input behaviour underneath.
[kdeglobals][General]
ColorScheme=ProtoOS Proton Dark

[kdeglobals][Icons]
Theme=ProtoOS-Aurora

[kdeglobals][KDE]
LookAndFeelPackage=org.protoos.desktop

[ksplashrc][KSplash]
Theme=org.protoos.desktop

[Windows]
BorderlessMaximizedWindows=true
